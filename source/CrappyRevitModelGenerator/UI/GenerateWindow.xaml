<Window x:Class="CrappyRevitModelGenerator.UI.GenerateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crappy Revit Model Generator"
        Width="720" Height="800" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=SeedBox}">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,6,10,8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,18,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: document + pre-flight warnings -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="DocumentText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Generates a small, intentionally low-quality but valid model. Every element is tagged so 'Clean Generated Model' can remove it again."
                       Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <Border x:Name="WarningsPanel" Visibility="Collapsed" Background="#FFFFF4CE" BorderBrush="#FFE0B84A" BorderThickness="1"
                    CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                <StackPanel x:Name="WarningsList"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>

                <!-- Run setup -->
                <GroupBox Header="Run setup">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Seed" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="SeedBox" Width="120" TextChanged="OnInputChanged"/>
                            <Button x:Name="NewSeedButton" Content="New seed" Margin="8,0,0,0" Padding="10,2" Click="OnNewSeed"/>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Hint}"
                                   Text="Same seed, document, settings and Revit version give the same result."/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Severity" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SeverityBox" Width="120" Margin="0,3" HorizontalAlignment="Left"
                                  SelectionChanged="OnInputChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}"
                                   Text="Scales quantities and defect probabilities; it does not change which scenarios run."/>

                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="DryRunBox"
                                  Content="Dry run (plan and count only, create nothing)"
                                  Checked="OnInputChanged" Unchecked="OnInputChanged"/>
                    </Grid>
                </GroupBox>

                <!-- Model content -->
                <GroupBox Header="Model content">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LevelsLabel" Text="Levels" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="LevelCountBox" TextChanged="OnInputChanged"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="LevelHeightLabel" Text="Level height (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="4" x:Name="LevelHeightBox" TextChanged="OnInputChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="FootprintWidthLabel" Text="Footprint width (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="FootprintWidthBox" TextChanged="OnInputChanged"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="FootprintDepthLabel" Text="Footprint depth (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="4" x:Name="FootprintDepthBox" TextChanged="OnInputChanged"/>
                        </Grid>
                        <TextBlock x:Name="ContentLimitsHint" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,2"/>
                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox x:Name="CreateFloorsBox" Content="Create floors" Checked="OnInputChanged" Unchecked="OnInputChanged"/>
                            <CheckBox x:Name="DoorsWindowsBox" Content="Doors and windows" Checked="OnInputChanged" Unchecked="OnInputChanged"/>
                            <CheckBox x:Name="FurnitureBox" Content="Furniture" Checked="OnInputChanged" Unchecked="OnInputChanged"/>
                            <CheckBox x:Name="RoomsBox" Content="Rooms" Checked="OnInputChanged" Unchecked="OnInputChanged"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Scenarios (populated from ScenarioCatalog in code-behind) -->
                <GroupBox Header="Scenarios">
                    <StackPanel>
                        <TextBlock Text="The baseline model always runs. Later scenarios build on earlier ones; hover a scenario for what it does."
                                   Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <StackPanel x:Name="ScenariosPanel"/>
                    </StackPanel>
                </GroupBox>

                <!-- Safety -->
                <GroupBox Header="Safety">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Max elements" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="MaxElementsBox" TextChanged="OnInputChanged"/>
                            <TextBlock Grid.Column="2" x:Name="MaxElementsHint" Style="{StaticResource Hint}"/>
                        </Grid>
                        <CheckBox x:Name="ConfirmBox" Margin="0,8,0,2" Checked="OnInputChanged" Unchecked="OnInputChanged"/>
                        <CheckBox x:Name="WorksharedBox" Content="Allow workshared documents (required when the active document is a central or local model)"
                                  Checked="OnInputChanged" Unchecked="OnInputChanged"/>
                        <CheckBox x:Name="SuppressBox" Content="Suppress all Revit warning dialogs during the run (still recorded in the report)"
                                  Checked="OnInputChanged" Unchecked="OnInputChanged"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Export JSON report to" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="ExportPathBox" TextChanged="OnInputChanged"/>
                            <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Padding="10,2" Click="OnBrowseExport"/>
                        </Grid>
                        <TextBlock Text="Optional. Nothing is written beside the model unless you choose a path here."
                                   Foreground="Gray" TextWrapping="Wrap" Margin="150,0,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Live estimate and validation -->
        <Border Grid.Row="2" BorderBrush="#FFCCCCCC" BorderThickness="1" Background="#FFF7F7F7" Padding="8,6" Margin="0,4,0,8">
            <StackPanel>
                <TextBlock x:Name="EstimateText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock x:Name="MessagesText" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="GenerateButton" Content="Generate" IsDefault="True" Click="OnGenerate" Style="{StaticResource ActionButton}"/>
            <Button x:Name="DryRunButton" Content="Dry run" Click="OnDryRun" Style="{StaticResource ActionButton}"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource ActionButton}"/>
        </StackPanel>
    </Grid>
</Window>
